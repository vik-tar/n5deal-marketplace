# Copy to .env and fill in. `.env` is git-ignored; this file is not.

# Postgres. The local Docker container documented in the README listens on
# 55432, not 5432, so it cannot collide with a Postgres already on this machine:
#   DATABASE_URL="postgresql://n5deal:n5deal@localhost:55432/n5deal"
# A hosted database (Neon and friends) wants sslmode=require:
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs the Auth.js session JWT. Any random 32 bytes; generate with:
#   openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional, and unset in this deployment by design. Without it the app runs
# fully: the three AI features hide their controls and every other surface —
# match scores, match reasons, the NDA gate — is deterministic and unaffected.
ANTHROPIC_API_KEY=""

# Only for running a local production build (`pnpm start`) on a host or port
# Auth.js did not infer; otherwise it answers UntrustedHost. Not needed for
# `pnpm dev`, and not needed on Vercel.
# AUTH_TRUST_HOST=true
